# Local development environment variables for running dms-core directly on
# the host (mvnw/IDE), against the docker-compose stack in infra/local/.
#
# Copy this file to .env (repo root) and fill in real values - .env is
# gitignored, this file is not. NEVER put a real secret in this file.
#
# Every variable here has a matching ${VAR:default} placeholder in
# backend/dms-core/src/main/resources/application.yml - that file's own
# defaults are what dms-core falls back to if a variable is left unset, so
# you only need to set the ones your setup actually differs on (e.g. you
# don't need REDIS_PORT unless you're not using the default 6379).
#
# This file is also loaded by infra/local/docker-compose.yml for the
# dms-core service specifically (in addition to, not instead of, the
# OpenBao-managed infra/secrets/dms-core.secrets.env) - see that file's
# STORAGE_CRED_* comment below for why: those variable NAMES are dynamic
# (one pair per StorageLocation.credentialRef), so they can't be listed as
# fixed keys in docker-compose.yml's own environment: block the way every
# other variable here is.

# =====================================================================
# Database (Postgres) - matches infra/local/docker-compose.yml's postgres
# service, reachable at localhost:5433 from the host, postgres:5432 from
# inside the docker network.
# =====================================================================
DB_URL=jdbc:postgresql://localhost:5433/dms_core_db
DB_USERNAME=dms_core_user
DB_PASSWORD=changeme
DB_POOL_SIZE=10

# =====================================================================
# RabbitMQ
# =====================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=dms
RABBITMQ_PASSWORD=changeme

# =====================================================================
# Redis
# =====================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================================================================
# Keycloak
# =====================================================================
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_REALM=oak-dms
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/oak-dms
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/oak-dms/protocol/openid-connect/certs
KEYCLOAK_ADMIN_CLIENT_ID=dms-core-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme
KEYCLOAK_WEB_CLIENT_ID=oak-dms-web
KEYCLOAK_AUTH_CONNECT_TIMEOUT_MS=3000
KEYCLOAK_AUTH_READ_TIMEOUT_MS=5000

# =====================================================================
# App-level secrets (sign the audit-correlation token / impersonation
# cookie - see AuditCorrelationTokenCodec / ImpersonationTokenCodec).
# MUST be overridden with a real secret outside local dev.
# =====================================================================
AUDIT_CORRELATION_SECRET=changeme-audit-correlation-secret-local-dev-only
IMPERSONATION_SECRET=changeme-impersonation-secret-local-dev-only
IMPERSONATION_SESSION_MINUTES=30

# =====================================================================
# Mail (PasswordResetService's own SMTP client - shares the mailpit
# container with Keycloak's separate SMTP config, but is a distinct
# client - see application.yml's spring.mail.* comment).
# =====================================================================
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
PASSWORD_RESET_MAIL_FROM=no-reply@oakdms.local
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# =====================================================================
# Misc app config
# =====================================================================
PRODUCT_NAME=Ledger
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=
FRONTEND_BASE_URL=http://localhost:3000
OUTBOX_RELAY_INTERVAL_MS=2000
SCHEMA_CACHE_TTL_SECONDS=3600
SERVER_PORT=8080
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN

# =====================================================================
# Object storage (com.oak.dms.storage - see docs/storage-architecture.md)
# =====================================================================
# S3 | FILE_SYSTEM - FILE_SYSTEM needs nothing else below to work.
STORAGE_PROVIDER=FILE_SYSTEM
STORAGE_FILESYSTEM_BASE_PATH=/data/dms/documents

# Only used when STORAGE_PROVIDER=S3 (or a tenant's own StorageLocation
# has a blank credentialRef, falling back to these deployment-wide
# defaults). S3_ENDPOINT blank = real AWS S3's own endpoint; set it to a
# MinIO or SeaweedFS S3-gateway URL to point this same adapter at either.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=false

# =====================================================================
# Per-StorageLocation S3 credentials (StorageLocation.credentialRef).
# S3ObjectStorageAdapter#resolveCredentials() resolves a location whose
# credentialRef is non-blank against STORAGE_CRED_<REF>_ACCESS_KEY /
# _SECRET_KEY, where <REF> is credentialRef uppercased with every '-'
# turned into '_' (only '-' is converted - any other punctuation in a
# credentialRef would need to already be a valid env-var character).
# Example: credentialRef "tenant-b-minio" needs:
#   STORAGE_CRED_TENANT_B_MINIO_ACCESS_KEY=...
#   STORAGE_CRED_TENANT_B_MINIO_SECRET_KEY=...
# Add one such pair per credentialRef you actually use locally - there is
# no fixed list, so none are pre-declared here.
# =====================================================================

# =====================================================================
# SeaweedFS (infra/local/docker-compose.yml's optional "seaweedfs"
# service) - a local, disposable S3-compatible target for
# S3ObjectStorageAdapter, no different from pointing it at MinIO or real
# AWS S3. NOT started or required by default (dms-core still defaults to
# STORAGE_PROVIDER=FILE_SYSTEM above) - only relevant if you bring this
# service up and register a StorageLocation against it.
#
# These two values seed the SeaweedFS container's own S3 identity config
# (generated at container start from these env vars - never committed to
# any file, never hardcoded in docker-compose.yml). If you register a
# StorageLocation for it, give it a credentialRef (e.g. "local-seaweedfs")
# and add the matching STORAGE_CRED_LOCAL_SEAWEEDFS_ACCESS_KEY/_SECRET_KEY
# pair above with these same values.
SEAWEEDFS_S3_ACCESS_KEY=changeme
SEAWEEDFS_S3_SECRET_KEY=changeme
# Not read by docker-compose.yml itself - documents the bucket name
# SeaweedFsDocumentUploadIT and a manually-registered StorageLocation
# should both use (endpoint http://localhost:8333, pathStyleAccess=true).
SEAWEEDFS_S3_BUCKET=dms-seaweedfs-test
# =====================================================================

# =====================================================================
# OpenBao (infra/secrets/*.enc.env encryption - scripts/openbao-*.sh).
# Not read by Spring Boot directly - only by those two scripts.
# =====================================================================
BAO_ADDR=http://127.0.0.1:8200
BAO_TOKEN=
OPENBAO_TRANSIT_KEY=dms-core-secrets
