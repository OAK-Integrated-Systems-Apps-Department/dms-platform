# Local development environment variables for running dms-core directly on
# the host (mvnw/IDE) against infra/local/docker-compose.yml's stack.
# GITIGNORED - never commit this file. See .env.example for the same
# variable names with placeholder (non-secret) values.

# =====================================================================
# Database (Postgres) - infra/local/docker-compose.yml's postgres service.
# =====================================================================
DB_URL=jdbc:postgresql://localhost:5433/dms_core_db
DB_USERNAME=dms_core_user
DB_PASSWORD=dms_core_pass
DB_POOL_SIZE=10

# =====================================================================
# RabbitMQ
# =====================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=dms
RABBITMQ_PASSWORD=changeme

# =====================================================================
# Redis
# =====================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================================================================
# Keycloak
# =====================================================================
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_REALM=oak-dms
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/oak-dms
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/oak-dms/protocol/openid-connect/certs
KEYCLOAK_ADMIN_CLIENT_ID=dms-core-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dms-core-admin-secret
KEYCLOAK_WEB_CLIENT_ID=oak-dms-web
KEYCLOAK_AUTH_CONNECT_TIMEOUT_MS=3000
KEYCLOAK_AUTH_READ_TIMEOUT_MS=5000

# =====================================================================
# App-level secrets - local-dev-only values, matches the ones already
# baked into application.yml's own defaults (never used outside local dev).
# =====================================================================
AUDIT_CORRELATION_SECRET=local-dev-audit-correlation-secret-change-in-prod
IMPERSONATION_SECRET=local-dev-impersonation-secret-change-in-prod
IMPERSONATION_SESSION_MINUTES=30

# =====================================================================
# Mail (mailpit, local dev only)
# =====================================================================
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
PASSWORD_RESET_MAIL_FROM=no-reply@oakdms.local
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# =====================================================================
# Misc app config
# =====================================================================
PRODUCT_NAME=Ledger
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=
FRONTEND_BASE_URL=http://localhost:3000
OUTBOX_RELAY_INTERVAL_MS=2000
SCHEMA_CACHE_TTL_SECONDS=3600
SERVER_PORT=8080
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN

# =====================================================================
# Object storage (com.oak.dms.storage) - FILE_SYSTEM needs nothing else
# below to work; this is the same zero-config default StorageProperties/
# StorageLocationBootstrap already fall back to.
# =====================================================================
STORAGE_PROVIDER=S3
STORAGE_FILESYSTEM_BASE_PATH=/data/dms/documents

# Only relevant if you switch STORAGE_PROVIDER to S3, or want the
# deployment-wide S3 default (used by any StorageLocation with a blank
# credentialRef) to point somewhere real. STORAGE_PROVIDER above stays
# FILE_SYSTEM - these values just point the deployment-wide S3 fallback at
# the local SeaweedFS container (infra/local/docker-compose.yml's
# "seaweedfs" service) so a StorageLocation with provider=S3 and a blank
# credentialRef would resolve against it. Values match that service's own
# S3 identity config exactly (see SEAWEEDFS_S3_* below) - same credentials
# either way, just two different resolution paths in
# S3ObjectStorageAdapter#resolveCredentials() (blank credentialRef vs a
# named one - see STORAGE_CRED_SEAWEEDFS_E2E_TEST_* further below).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=dms-seaweedfs-test
S3_ACCESS_KEY=DMSTESTACCESSKEY01
S3_SECRET_KEY=DmsTestSecretKey0123456789
S3_PATH_STYLE_ACCESS=true

# Only relevant if you switch STORAGE_PROVIDER to AZURE_BLOB. Left blank -
# no Azure Storage account is configured for local dev yet; see
# docs/storage-architecture.md section 7.
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# =====================================================================
# Per-StorageLocation S3 credentials (StorageLocation.credentialRef) - see
# S3ObjectStorageAdapter#resolveCredentials(): STORAGE_CRED_<REF>_ACCESS_KEY
# / _SECRET_KEY, where <REF> is credentialRef uppercased with '-' -> '_'.
# "seaweedfs-e2e-test" matches SeaweedFsDocumentUploadIT's own
# CREDENTIAL_REF constant exactly (uppercased -> SEAWEEDFS_E2E_TEST) -
# these two are for a StorageLocation row created with that same
# credentialRef outside the test itself (e.g. via
# POST /api/v1/storage-locations for manual local testing); the test
# itself sets these as JVM system properties at runtime and never reads
# them from here, so it doesn't depend on this section being present.
STORAGE_CRED_SEAWEEDFS_E2E_TEST_ACCESS_KEY=DMSTESTACCESSKEY01
STORAGE_CRED_SEAWEEDFS_E2E_TEST_SECRET_KEY=DmsTestSecretKey0123456789
# Add one more such pair per any OTHER credentialRef you actually create,
# e.g. for a differently-named local MinIO location "local-minio":
#   STORAGE_CRED_LOCAL_MINIO_ACCESS_KEY=...
#   STORAGE_CRED_LOCAL_MINIO_SECRET_KEY=...
# =====================================================================

# =====================================================================
# SeaweedFS (infra/local/docker-compose.yml's optional "seaweedfs"
# service) - seeds that container's own S3 identity config. Values match
# SeaweedFsDocumentUploadIT's own hardcoded ACCESS_KEY/SECRET_KEY
# constants exactly, so that existing test authenticates against this
# persistent container without any Java change.
# =====================================================================
SEAWEEDFS_S3_ACCESS_KEY=DMSTESTACCESSKEY01
SEAWEEDFS_S3_SECRET_KEY=DmsTestSecretKey0123456789
SEAWEEDFS_S3_BUCKET=dms-seaweedfs-test

# =====================================================================
# OpenBao (infra/secrets/*.enc.env encryption/decryption scripts only -
# not read by Spring Boot). BAO_TOKEN is a live Vault token, left blank -
# export it in your shell when actually running scripts/openbao-*.sh.
# =====================================================================
BAO_ADDR=http://127.0.0.1:8200
BAO_TOKEN=
OPENBAO_TRANSIT_KEY=dms-core-secrets
