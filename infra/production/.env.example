# Template for the SERVER-SIDE infra/production/.env (next to
# docker-compose.yml). Copy it on the server, fill in real values and
# `chmod 600 .env`. The real file is gitignored and must never be committed.
# NEVER put a real secret in this template.
#
# With OpenBao (docs/secrets-openbao.md) the keys listed in secret-keys.txt
# live in OpenBao instead: `bao-ops.sh strip` removes them from the real
# .env, which then holds configuration only.
#
# Generate strong values with:  openssl rand -base64 36

# --- Compose -------------------------------------------------------------
# Must match the project name the stack already runs under on the server,
# otherwise Compose creates NEW, EMPTY volumes (see docs/deployment.md
# "Existing data"). Check with: docker compose ls
COMPOSE_PROJECT_NAME=dms

# Managed by deploy.sh - the image tag (git commit SHA) currently deployed.
IMAGE_TAG=replace-with-commit-sha

# Optional: override image repositories (defaults are the GHCR names).
# OCR_WORKER_IMAGE=ghcr.io/oak-integrated-systems-apps-department/ocr-worker
# DMS_CORE_IMAGE=ghcr.io/oak-integrated-systems-apps-department/dms-core
# FRONTEND_IMAGE=ghcr.io/oak-integrated-systems-apps-department/dms-frontend

# --- Where each service runs -------------------------------------------------
# Every infrastructure service below ships as a container in this stack. A
# client who wants its own (AWS RDS, Azure Database for PostgreSQL, a managed
# Redis or RabbitMQ, S3, a real SMTP relay, ...) removes that service's name
# from COMPOSE_PROFILES and fills in the matching settings. Leaving a name in
# keeps the bundled container, which is what the defaults assume. Full guide,
# with examples per provider: docs/external-services.md
#
# Keycloak always runs here (its database is configurable below), as do dms-core,
# the frontend and the OCR worker.
COMPOSE_PROFILES=postgres,redis,rabbitmq,seaweedfs,mailpit,clamav,gotenberg

# PostgreSQL - used when `postgres` is NOT in COMPOSE_PROFILES. The databases and
# login must already exist (the bundled container's postgres/init-multiple-dbs.sh
# shows exactly what: dms_core_db owned by dms_core_user, and keycloak_db).
# DB_SSLMODE: disable | prefer | require | verify-full (managed services: require).
#DB_HOST=mydb.abc123.eu-west-1.rds.amazonaws.com
#DB_PORT=5432
#DB_SSLMODE=require
#DMS_CORE_DB_NAME=dms_core_db
#DMS_CORE_DB_USER=dms_core_user
#KEYCLOAK_DB_NAME=keycloak_db
#KEYCLOAK_DB_USER=keycloak
#KEYCLOAK_DB_PASSWORD=CHANGE_ME

# Redis - when `redis` is NOT in COMPOSE_PROFILES (REDIS_PASSWORD may be empty).
#REDIS_HOST=my-cache.example.com
#REDIS_PORT=6380
#SPRING_DATA_REDIS_SSL_ENABLED=true

# RabbitMQ - when `rabbitmq` is NOT in COMPOSE_PROFILES. RABBITMQ_DEFAULT_PASS
# below is then the password of RABBITMQ_USERNAME on that broker.
#RABBITMQ_HOST=my-broker.example.com
#RABBITMQ_PORT=5671
#RABBITMQ_USERNAME=dms
#RABBITMQ_SCHEME=amqps
#SPRING_RABBITMQ_SSL_ENABLED=true

# Malware scanning (ClamAV) - when `clamav` is NOT in COMPOSE_PROFILES.
#CLAMAV_HOST=clamav.internal.example.com
#CLAMAV_PORT=3310

# Office previews (Gotenberg) - when `gotenberg` is NOT in COMPOSE_PROFILES.
#PREVIEW_CONVERTER_URL=http://gotenberg.internal.example.com:3000

# Mail: when `mailpit` is NOT in COMPOSE_PROFILES, set the SMTP_* values in the
# Mail section further down to a real relay (SMTP_HOST must not stay "mailpit").

# Where documents are stored. Default (nothing set): FILE_SYSTEM, the
# documents_data volume. Pick one; `seaweedfs` in COMPOSE_PROFILES only matters
# if you use the bundled S3 below. A tenant can also be given its own storage
# location inside the app, which overrides this default.
#
# Amazon S3 (leave S3_ENDPOINT empty for AWS itself; set it for MinIO, Ceph,
# Wasabi, ...). The bucket must exist. S3_ACCESS_KEY / S3_SECRET_KEY are secrets.
#STORAGE_PROVIDER=S3
#S3_ENDPOINT=
#S3_REGION=eu-west-1
#S3_BUCKET=acme-dms-documents
#S3_ACCESS_KEY=CHANGE_ME
#S3_SECRET_KEY=CHANGE_ME
#S3_PATH_STYLE_ACCESS=false
#S3_SSE=AES256
#
# Azure Blob Storage. AZURE_STORAGE_ACCOUNT_KEY is a secret.
#STORAGE_PROVIDER=AZURE_BLOB
#AZURE_STORAGE_ENDPOINT=https://acme.blob.core.windows.net
#AZURE_STORAGE_ACCOUNT_NAME=acme
#AZURE_STORAGE_CONTAINER=dms-documents
#AZURE_STORAGE_ACCOUNT_KEY=CHANGE_ME

# --- Public address --------------------------------------------------------
# The ONE origin browsers use (nginx on port 80). Keycloak's issuer/links,
# the web client's redirect URIs, CORS and email links are all derived from
# it. No trailing slash.
PUBLIC_URL=http://192.168.0.10

# Browsers only send Secure cookies over HTTPS (or to localhost). Over plain
# HTTP on 192.168.0.10 this MUST be false or login silently fails. Set it
# back to true as soon as nginx terminates TLS.
AUTH_COOKIE_SECURE=false

# Address the three browser-facing ports (3000, 8080, 8081) are published on.
# 127.0.0.1 when nginx runs on this server (the default). When nginx is on a
# different server, set this server's LAN address and firewall those ports to the
# nginx server only - see docs/clients/oakidocs.md for a worked example.
#PROXY_BIND_ADDRESS=127.0.0.1

# --- Secrets (same names as infra/secrets/dms-core.secrets.env) ------------
# Replace EVERY CHANGE_ME - deploy.sh refuses to run while any remain.
# Also used by Keycloak (it connects as the postgres user), so there is no
# separate KC_DB_PASSWORD in production.
POSTGRES_PASSWORD=CHANGE_ME
# Must equal the password dms_core_user ALREADY has if the database exists
# (the local init script created it as 'dms_core_pass').
DMS_CORE_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Platform superadmin for the DMS itself (not the Keycloak console).
# Applied ONLY at first install, when the account still has no password;
# the holder is then forced to change it at first login, so this value is
# never the lasting credential. Changing it later in this file does NOT
# reset the account - use the Keycloak admin console for that.
# Unique per client: this used to be a committed password shared by every
# deployment, which is exactly what it must not be.
KEYCLOAK_SUPERADMIN_USERNAME=superadmin@gmail.com
KEYCLOAK_SUPERADMIN_PASSWORD=CHANGE_ME
# Must equal the dms-core-admin client's secret in Keycloak (realm import
# uses this value on first import; an existing realm keeps its own).
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
RABBITMQ_DEFAULT_PASS=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
AUDIT_CORRELATION_SECRET=CHANGE_ME
IMPERSONATION_SECRET=CHANGE_ME
# OCR: the token dms-core and the OCR worker both check on internal calls, and
# the key dms-core signs per-job read grants with. Two different values.
INTERNAL_SERVICE_TOKEN=CHANGE_ME
OCR_JOB_TOKEN_SECRET=CHANGE_ME
SEAWEEDFS_S3_ACCESS_KEY=CHANGE_ME
SEAWEEDFS_S3_SECRET_KEY=CHANGE_ME

# --- Mail ------------------------------------------------------------------
# Defaults send everything to the local mailpit sink (not delivered). Point
# these at a real SMTP relay for real email.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@oakdms.local
SMTP_FROM_DISPLAY_NAME=Oak DMS
SMTP_AUTH=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=false

# Who receives monitoring alerts (Alertmanager). Empty = nothing is sent; the
# alerts still show on the System Monitoring screen. One address, or several
# separated by commas. Sent through the SMTP_* relay above, so point that at a
# real relay first - with SMTP_HOST=mailpit the mail goes nowhere.
ALERT_EMAIL_TO=
# Optional: the public address of the DMS, e.g. https://dms.example.com/admin/monitoring
# - put in the email as a link to the System Monitoring screen. Empty = no link.
ALERT_LINK=

# Memory ceilings. Every container has one (docker-compose.yml), so a runaway
# is stopped before it takes the server with it. These three are the ones a
# client with unusually large data may need to raise; leave them commented to
# keep the defaults. They are ceilings, not reservations: a container only
# uses what it needs. The backend's heap follows DMS_CORE_MEM_LIMIT
# automatically (75% of it), so nothing else needs changing alongside.
#
# A server for the whole stack idles at about 3.5 GB, so 8 GB is comfortable
# and 16 GB generous. If ContainerMemoryNearLimit fires, raise the one it names.
#DMS_CORE_MEM_LIMIT=2560m
#KEYCLOAK_MEM_LIMIT=1536m
#POSTGRES_MEM_LIMIT=4g
# Keep these about 1/4 and 3/4 of POSTGRES_MEM_LIMIT.
#POSTGRES_SHARED_BUFFERS=1GB
#POSTGRES_EFFECTIVE_CACHE_SIZE=3GB

# --- Monitoring (Prometheus + Grafana) -------------------------------------
# The stack runs without these set, but Grafana will not start without an
# admin password and postgres-exporter needs its read-only database login.
# Create that login once on the server:
#   CREATE ROLE dms_metrics LOGIN PASSWORD '<POSTGRES_METRICS_PASSWORD>';
#   GRANT pg_monitor TO dms_metrics;
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Public URL of the embedded dashboard - must match the nginx /grafana/
# location and the host the browser uses.
GRAFANA_ROOT_URL=http://192.168.0.10/grafana/
# Read-only anonymous viewing, so the DMS admin page can embed the dashboard
# without a second login. Set to false to require a Grafana login instead
# (the embedded panel then shows Grafana's sign-in form).
GRAFANA_ANONYMOUS_ENABLED=true
POSTGRES_METRICS_USER=dms_metrics
POSTGRES_METRICS_PASSWORD=CHANGE_ME
# How much metrics history to keep, and a hard cap on its disk use. This
# shares a disk with the documents - check free space before raising it.
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=8GB
# This client's short name, e.g. "acme" or "northbridge". Each client runs
# their own DMS stack; this is the label that tells them apart once their
# metrics are forwarded to a central Prometheus (not built yet - see
# infra/monitoring/README.md). It does not affect this stack's own Grafana.
# Set it at install time so the whole fleet is already named correctly when
# central monitoring is switched on, and leave it alone from then on.
# A bare CHANGE_ME on purpose, so deploy.sh prompts for it rather than
# letting a stack go out anonymous.
MONITORING_CLIENT=CHANGE_ME
MONITORING_ENVIRONMENT=production
