# Template for infra/local/.env - the file docker compose reads automatically
# for ${...} substitution in docker-compose.yml. Copy to .env (gitignored)
# and fill in real values. NEVER put a real secret or a real host in this file.

# Hostname/IP browsers use to reach this stack - the ONE place to change it
# per deployment (see docker-compose.yml header). localhost for local dev,
# e.g. 192.168.0.10 for a LAN server.
PUBLIC_HOST=localhost
# Browsers only send Secure cookies over plain HTTP to localhost. Set to
# false only when PUBLIC_HOST is not localhost AND there is no HTTPS.
AUTH_COOKIE_SECURE=true

# Secrets - use the values from infra/secrets (OpenBao), never commit them.
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_PASS=
KEYCLOAK_ADMIN_PASSWORD=
DMS_CORE_DB_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KC_DB_PASSWORD=
AUDIT_CORRELATION_SECRET=
IMPERSONATION_SECRET=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
OCR_WORKER_INTERNAL_TOKEN=

# --- Monitoring (Prometheus + Grafana) -------------------------------------
# All optional locally: the compose file defaults to admin/admin and a 15-day
# retention, which is fine on a dev machine. Grafana is on
# http://localhost:3001/grafana/ and Prometheus on http://localhost:9090.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Only needed if you reach the DMS as something other than localhost (see
# PUBLIC_HOST above) - it must match the host the browser uses, or Grafana
# redirects the embedded dashboard to the wrong origin.
GRAFANA_ROOT_URL=
PROMETHEUS_RETENTION=
# Only matters once client stacks forward metrics to a central Prometheus;
# defaults to "dev" locally.
MONITORING_CLIENT=
MONITORING_ENVIRONMENT=

# Platform superadmin. Defaults to SuperAdmin123@ locally (dev only - the
# realm file no longer carries any password). Set only at first install,
# when the account has no credential yet.
KEYCLOAK_SUPERADMIN_USERNAME=
KEYCLOAK_SUPERADMIN_PASSWORD=
