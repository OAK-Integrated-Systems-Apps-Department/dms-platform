# Template for infra/local/.env - the file docker compose reads automatically
# for ${...} substitution in docker-compose.yml. Copy to .env (gitignored)
# and fill in real values. NEVER put a real secret or a real host in this file.

# Hostname/IP browsers use to reach this stack - the ONE place to change it
# per deployment (see docker-compose.yml header). localhost for local dev,
# e.g. 192.168.0.10 for a LAN server.
PUBLIC_HOST=localhost
# Browsers only send Secure cookies over plain HTTP to localhost. Set to
# false only when PUBLIC_HOST is not localhost AND there is no HTTPS.
AUTH_COOKIE_SECURE=true

# Secrets - use the values from infra/secrets (OpenBao), never commit them.
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_PASS=
KEYCLOAK_ADMIN_PASSWORD=
DMS_CORE_DB_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KC_DB_PASSWORD=
AUDIT_CORRELATION_SECRET=
IMPERSONATION_SECRET=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
OCR_WORKER_INTERNAL_TOKEN=
