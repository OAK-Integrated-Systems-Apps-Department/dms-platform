Ready-to-apply CI change: run the search integration tests against a real OpenSearch (with analysis-icu).

Apply from the repository root with:   git apply docs/search-ci.patch   (check first with: git apply --check docs/search-ci.patch)
It edits only the `integration` job of .github/workflows/ci.yml. NOT applied: workflows are not edited by the search work.
See docs/search-operations.md, "CI".

--- a/.github/workflows/ci.yml	2026-11-16 12:21:41
+++ b/.github/workflows/ci.yml	2026-11-16 13:45:51
@@ -154,6 +154,10 @@
       RABBITMQ_HOST: localhost
       RABBITMQ_USERNAME: dms
       RABBITMQ_PASSWORD: ci-only-rabbitmq
+      # The search ITs (OpenSearchRestEngineIT, Search*IT) skip without a node; with one they must run, so a node that
+      # failed to start fails the job instead of silently skipping them (SearchIntegrationTestSupport).
+      OPENSEARCH_IT_URL: http://localhost:9201
+      OPENSEARCH_IT_REQUIRED: "true"
     steps:
       - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5
 
@@ -171,6 +175,21 @@
           cache: maven
           cache-dependency-path: backend/**/pom.xml
 
+      # OpenSearch with the analysis-icu plugin. Not a `services:` container: a service container cannot install a plugin,
+      # so the image is built from infra/local/opensearch/Dockerfile (the same one the compose stack uses). Security is off:
+      # a throwaway node on the runner, reachable only from this job.
+      - name: Start OpenSearch (with analysis-icu)
+        run: |
+          docker build -t dms-opensearch:ci --build-arg OS_VERSION=3.7.0 infra/local/opensearch
+          docker run -d --name dms-it-opensearch -p 9201:9200 \
+            -e discovery.type=single-node -e DISABLE_SECURITY_PLUGIN=true -e DISABLE_INSTALL_DEMO_CONFIG=true \
+            -e OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m" dms-opensearch:ci
+          for _ in $(seq 1 60); do
+            curl -sf http://localhost:9201/_cluster/health >/dev/null && exit 0
+            sleep 2
+          done
+          echo "::error::OpenSearch did not come up"; docker logs dms-it-opensearch; exit 1
+
       # Writes OPENBAO_IT_* and KEYCLOAK_* (CI-only, generated per run) to
       # $GITHUB_ENV for the next step.
       - name: Start OpenBao and Keycloak
@@ -179,9 +198,17 @@
       # -Dtest bypasses the excludes in pom.xml, so the two ITs that need a ClamAV daemon (an upload
       # must be scanned clean before the call returns) are left out here by name. No clamd runs in
       # this job; run them locally against the full compose stack.
+      #
+      # -DexcludedGroups=perf: `-Dtest` runs through surefire, which does not read the pom's it.excludedGroups, so the
+      # opt-in @Tag("perf") ITs (SearchScaleIT: 500,000 documents; SearchRealPathBenchmarkIT: 100,000) would run here
+      # now that a node exists. They also guard themselves with an explicit switch; this is the second lock.
       - name: Integration tests (*IT)
         working-directory: backend
-        run: ./dms-core/mvnw -B -ntp -f pom.xml -pl dms-core test -Dtest='*IT,!DocumentUploadIT,!DocumentUploadOcrQueueingIT' -Dsurefire.failIfNoSpecifiedTests=false
+        run: ./dms-core/mvnw -B -ntp -f pom.xml -pl dms-core test -Dtest='*IT,!DocumentUploadIT,!DocumentUploadOcrQueueingIT' -Dsurefire.failIfNoSpecifiedTests=false -DexcludedGroups=perf
+
+      - name: OpenSearch logs
+        if: failure()
+        run: docker logs dms-it-opensearch 2>&1 | tail -n 200
 
       - name: Upload test reports
         if: failure()
