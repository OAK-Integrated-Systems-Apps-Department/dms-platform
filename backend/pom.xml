<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Per Tech Stack Review: Java 21 + Spring Boot 4.1.0 - Keep -->
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.oak.dms</groupId>
    <artifactId>dms-platform-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>dms-platform-backend</name>
    <description>
        Parent aggregator for every Oak DMS backend deployable: the
        dms-core modular monolith plus the worker deployables under
        workers/. Centralizes shared dependency versions (per the Tech
        Stack Review) so dms-core and each worker stay in lockstep rather
        than drifting independently.
    </description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>

        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.36</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>3.0.3</springdoc.version>

        <!--
          keycloak-admin-client: target server is 26.7.0 (Tech Stack
          Review), but the admin-client Java artifact has not been
          reliably published to Maven Central past 26.0.x as of this
          writing (github.com/keycloak/keycloak/issues/36128, open at
          time of writing). Re-check for a matching 26.7.x artifact
          before release.
        -->
        <keycloak-admin-client.version>26.0.12</keycloak-admin-client.version>

        <!--
          Code analysis. JaCoCo measures coverage during `mvn verify`;
          sonar-maven-plugin uploads the result. The two are separate on
          purpose - coverage is worth having whether or not anyone runs
          Sonar, so JaCoCo is bound to the normal build and `sonar:sonar`
          is only ever invoked explicitly.
        -->
        <sonar-maven-plugin.version>5.1.0.4751</sonar-maven-plugin.version>

        <!--
          The backend and the frontend are two Sonar projects, not one. A
          single project key can only be written by one scanner run: the
          Maven scanner here and the CLI scanner that analyses frontend/
          would each overwrite the other's results.

          sonar.host.url and sonar.token are deliberately NOT here - a token
          is a credential and belongs in the environment (SONAR_HOST_URL /
          SONAR_TOKEN), never in a committed file.
        -->
        <sonar.projectKey>oak-dms-backend</sonar.projectKey>
        <sonar.projectName>Oak DMS - backend</sonar.projectName>
        <!--
          Generated code has no author to fix what Sonar finds in it, and
          counting it drags the coverage figure toward meaningless.
        -->
        <sonar.coverage.exclusions>
            **/dto/**,**/*Response.java,**/*Request.java,**/config/**,**/DmsCoreApplication.java
        </sonar.coverage.exclusions>
        <!--
          Left at its default (target/site/jacoco/jacoco.xml, per module) -
          which is exactly where the report goal below writes. Set it only
          if that ever stops being true.
          <sonar.coverage.jacoco.xmlReportPaths>
        -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Per Tech Stack Review: Testcontainers 1.20.x - Keep.
                 Verify against the latest 1.20.x patch before release. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.20.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
              Pinned rather than resolved as "whatever is newest", so an
              analysis run a year from now is the same analysis run. Never
              bound to a phase: `sonar:sonar` is invoked explicitly, so an
              ordinary build never needs a Sonar server to exist.

              Declared here because `sonar:sonar` is invoked on THIS pom
              (-f backend/pom.xml), which analyses the whole reactor in one
              pass. JaCoCo is NOT here - see the note on <modules> below.
            -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

    <!--
      NOTE: this pom aggregates its modules but does not parent them.
      dms-core (and each worker) declares spring-boot-starter-parent as its
      own <parent>, so nothing in this file's <build> or <properties> is
      inherited by them - the modules only get built together, not
      configured together.

      That is why jacoco-maven-plugin is declared in dms-core/pom.xml rather
      than here: put in this file it would attach only to this pom, which
      has no source to measure, and coverage would silently come out empty.
      Any new module needs its own copy of that plugin block.
    -->
    <modules>
        <module>dms-core</module>
        <!--
          Uncomment as each worker deployable is actually implemented -
          left commented rather than removed so the intended module list
          stays visible (see workers/*/README.md for what each will do):

        <module>workers/document-processing-worker</module>
        <module>workers/integration-worker</module>
        <module>workers/batch-worker</module>
        -->
    </modules>
</project>
