# Copy to .env for local (non-docker) runs against the docker-compose stack.
# See README.md "Known limitation" re: DB_URL currently needing dms_core_user's
# own credentials until a scoped ocr_worker_user grant exists.
#
# NOTE: ocr-worker has no published host port in docker-compose.yml (see
# README "Auth & service exposure" -- internal-only). Running it locally
# via `uvicorn` directly (not in the container) is still fine for dev, but
# nothing on the docker network can reach *this* instance -- it's only
# reachable at localhost:8090 from your own machine, same as any other
# locally-run process.

DB_URL=postgresql+psycopg://dms_core_user:dms_core_pass@localhost:5433/dms_core_db
RABBITMQ_URL=amqp://dms:changeme@localhost:5672/
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_SOURCE_BUCKET=oakdms-documents
MINIO_OCR_OUTPUT_BUCKET=oakdms-ocr-output
MIN_CONFIDENCE_THRESHOLD=0.95
PREFETCH_COUNT=4
WORKER_POOL_SIZE=4
LOG_LEVEL=INFO
API_PORT=8090
INTERNAL_SERVICE_TOKEN=change-me-local-dev-internal-token
