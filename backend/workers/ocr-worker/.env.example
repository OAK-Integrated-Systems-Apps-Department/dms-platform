# Copy to .env for local (non-docker) runs against the docker-compose stack.
# See README.md "Known limitation" re: DB_URL currently needing dms_core_user's
# own credentials until a scoped ocr_worker_user grant exists.
#
# NOTE: ocr-worker has no published host port in docker-compose.yml (see
# README "Auth & service exposure" -- internal-only). Running it locally
# via `uvicorn` directly (not in the container) is still fine for dev, but
# nothing on the docker network can reach *this* instance -- it's only
# reachable at localhost:8090 from your own machine, same as any other
# locally-run process.

DB_URL=postgresql+psycopg://dms_core_user:dms_core_pass@localhost:5433/dms_core_db
RABBITMQ_URL=amqp://dms:changeme@localhost:5672/
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_SOURCE_BUCKET=oakdms-documents
MINIO_OCR_OUTPUT_BUCKET=oakdms-ocr-output
MIN_CONFIDENCE_THRESHOLD=0.95

# Pool size and prefetch. PREFETCH_COUNT defaults to OCR_WORKER_PROCESSES
# and is normally best left unset -- a worker that holds more deliveries
# than it has processes keeps them invisible to every other consumer for
# as long as the running documents take (up to ~1000s for a 35-page scan).
#
# WORKER_POOL_SIZE used to be set here and is NOT a Settings field at all,
# so pydantic-settings silently swallowed it (extra="ignore") -- it never
# did anything. The real knob is OCR_WORKER_PROCESSES, and raising it
# raises memory by roughly 3.4 GiB per process against the container's
# 8.5 GiB mem_limit, so change mem_limit with it.
# OCR_WORKER_PROCESSES=2

# Preprocessing toggles (README "Preprocessing"). Orientation correction
# is ON by default and both lines below are the defaults, shown because
# turning it off is a measured ~83-point field-accuracy loss on any page
# that arrives rotated -- not a knob to flip casually while debugging.
# OCR_ORIENTATION_ENABLED=true
# OCR_ORIENTATION_MIN_CONFIDENCE=0.6

# Hard ceiling on the rendered area of one page. Measured, not chosen:
# RSS grows ~0.7 GiB per megapixel and PaddleOCR is OOM-killed above
# ~6 MP per inference call at the container's 8.5 GiB limit -- with ONE
# process, where production runs two. Lower it on a smaller container;
# raising it has measured cost and no measured benefit (see the README's
# "The render budget").
# OCR_RENDER_MAX_MP=1.81

# Per-page routing (README "Per-page routing"). Thresholds are
# PROVISIONAL -- tuned on synthetic fixtures, never seen against a real
# document. Turning routing off restores the pre-Step-7 rule exactly:
# any native text at all wins, which returns confident nonsense for a
# scan carrying an invisible (cid:NN) layer.
# OCR_ROUTING_ENABLED=true
# OCR_ROUTING_MAX_GARBAGE_RATIO=0.30
# OCR_ROUTING_MIN_PLAUSIBILITY=0.50
# OCR_ROUTING_MIN_UNCOVERED_IMAGE=0.15

# Retry budget per failure cause (README "Retries are per cause"). The
# number is RETRIES after the first try, so 0 means "try once, never
# again". Parsed and validated at startup -- an unknown code or a
# non-integer FAILS the process rather than being silently ignored,
# because a typo would quietly restore the old "retry everything five
# times" behaviour and nobody would notice until a queue backed up.
# OCR_RETRY_ATTEMPTS_BY_CODE=TIMEOUT=1,ENCRYPTED_PDF=0,CORRUPT_FILE=0,UNSUPPORTED_FORMAT=0,TOO_MANY_PAGES=0,FILE_TOO_LARGE=0,WORKER_CRASH=3,ENGINE_ERROR=3
# OCR_MAX_WORKER_CRASHES_PER_VERSION=2

# Bound Docling's table-structure pass, per page (README "Preprocessing").
# TableFormer's cost follows the grid it predicts and that prediction is
# unbounded: measured 87s on a one-page PDF where it invented a 378x2 grid
# for a page holding 24 cells, then dropped all 24. On the deadline the
# page keeps its text and loses only table structure, and the page output
# carries flags.table_structure_skipped. 0 disables the bound.
# OCR_TABLE_TIMEOUT_PER_PAGE_S=20.0

# Bake a page's /Rotate into its content before Docling sees it. PyMuPDF
# already applies /Rotate for our own extraction and rendering, so this
# changes nothing we read -- verified as a 0.000pt bbox delta across every
# word of the rotated fixture -- but it took that page from 138.9s to
# 2.3s. Off only for diagnosing something else.
# OCR_NORMALIZE_PAGE_ROTATION=true

# Per-page image quality (README "Image quality"). Measured on every
# rasterized page into pages[].quality; below a threshold the page also
# gets flags.poor_image_quality with reasons (LOW_RESOLUTION / BLURRY /
# LOW_CONTRAST). A page is NEVER rejected for quality. The blur and
# contrast bars are PROVISIONAL -- set against synthetic degradation, not
# against a real blurred photograph.
# OCR_QUALITY_ENABLED=true
# OCR_QUALITY_MIN_DPI=150.0
# OCR_QUALITY_MIN_BLUR=100.0
# OCR_QUALITY_MIN_CONTRAST=35.0

# Pin the model loaders to their local cache, removing the ONE outbound
# call this worker otherwise makes (HuggingFace revision resolution at
# converter construction -- a model name, never document content). See
# the README's "No LLM, by design". Default false because the model
# caches are named volumes populated on first use, NOT baked into the
# image: turning this on before the first warm-up leaves a fresh
# deployment unable to fetch weights at all.
# OCR_OFFLINE_MODELS=false
LOG_LEVEL=INFO
API_PORT=8090
INTERNAL_SERVICE_TOKEN=change-me-local-dev-internal-token

# Per-document timeout: budget = BASE + page_count * PER_PAGE, armed from
# the document's REAL page count. Per-page raised 25 -> 45 on 2026-09-29:
# under a 10-way concurrent burst a 35-page scan measured 29.2s/page,
# already past the old 25s allowance, and was killed at its budget for
# being slow rather than for hanging. 1.5 x 29.2 = 43.8, rounded to 45.
# OCR_TIMEOUT_BASE_S=60
# OCR_TIMEOUT_PER_PAGE_S=45
# OCR_TIMEOUT_HARD_GRACE_S=30

# MUST stay above BASE + OCR_MAX_PAGES * PER_PAGE + 2 * HARD_GRACE
# (60 + 50*45 + 60 = 2370s). Raised 1800 -> 2700 as a direct consequence
# of the per-page rise: a lease shorter than that worst case lets the
# reaper reclaim a row from a worker that is still working on it, and the
# retry restarts the document from scratch.
# OCR_LEASE_DURATION_S=2700

# Searchable PDF rendition (README "Searchable PDF rendition"). The
# SOURCE page is copied, never re-rasterized, so a 300 DPI scan stays 300
# DPI. Invisible text is added only where recognition happened -- a
# native-text page keeps its own exact layer and gets no overlay. A
# failure is recorded in the OCR output's flags.searchable_pdf_failed
# with a reason, never silently dropped.
# OCR_SEARCHABLE_PDF_ENABLED=true
